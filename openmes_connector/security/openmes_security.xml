<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="openmes_work_order_company_rule" model="ir.rule">
        <field name="name">OpenMES work order: multi-company</field>
        <field name="model_id" ref="model_openmes_work_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_work_order_consumption_company_rule" model="ir.rule">
        <field name="name">OpenMES work order consumption: multi-company</field>
        <field name="model_id" ref="model_openmes_work_order_consumption"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_stock_document_company_rule" model="ir.rule">
        <field name="name">OpenMES stock document: multi-company</field>
        <field name="model_id" ref="model_openmes_stock_document"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_stock_document_line_company_rule" model="ir.rule">
        <field name="name">OpenMES stock document line: multi-company</field>
        <field name="model_id" ref="model_openmes_stock_document_line"/>
        <field name="domain_force">['|', ('document_id.company_id', '=', False), ('document_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_line_company_rule" model="ir.rule">
        <field name="name">OpenMES line: multi-company</field>
        <field name="model_id" ref="model_openmes_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_sync_log_company_rule" model="ir.rule">
        <field name="name">OpenMES sync log: multi-company</field>
        <field name="model_id" ref="model_openmes_sync_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_webhook_event_company_rule" model="ir.rule">
        <field name="name">OpenMES webhook event: multi-company</field>
        <field name="model_id" ref="model_openmes_webhook_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="openmes_material_lot_sent_company_rule" model="ir.rule">
        <field name="name">OpenMES material lot sent: multi-company</field>
        <field name="model_id" ref="model_openmes_material_lot_sent"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

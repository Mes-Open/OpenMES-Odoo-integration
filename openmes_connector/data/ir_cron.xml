<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_openmes_send" model="ir.cron">
            <field name="name">OpenMES: send work orders</field>
            <field name="model_id" ref="model_openmes_work_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_openmes_send()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_pull_status" model="ir.cron">
            <field name="name">OpenMES: pull work order status</field>
            <field name="model_id" ref="model_openmes_work_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_openmes_pull_status()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_settlements" model="ir.cron">
            <field name="name">OpenMES: fetch work order settlements</field>
            <field name="model_id" ref="model_openmes_work_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_openmes_fetch_settlements()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_sync_master_data" model="ir.cron">
            <field name="name">OpenMES: sync products, materials and BoMs</field>
            <field name="model_id" ref="model_openmes_sync_log"/>
            <field name="state">code</field>
            <field name="code">env['openmes.sync']._cron_sync_master_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_sync_stock" model="ir.cron">
            <field name="name">OpenMES: sync stock</field>
            <field name="model_id" ref="model_openmes_sync_log"/>
            <field name="state">code</field>
            <field name="code">env['openmes.sync']._cron_sync_stock()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_stock_documents" model="ir.cron">
            <field name="name">OpenMES: book stock documents</field>
            <field name="model_id" ref="model_openmes_stock_document"/>
            <field name="state">code</field>
            <field name="code">model._cron_openmes_stock_documents()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_refresh_lines" model="ir.cron">
            <field name="name">OpenMES: refresh production lines</field>
            <field name="model_id" ref="model_openmes_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_openmes_refresh_lines()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_openmes_webhook_events" model="ir.cron">
            <field name="name">OpenMES: process webhook events</field>
            <field name="model_id" ref="model_openmes_webhook_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_openmes_process_events()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>

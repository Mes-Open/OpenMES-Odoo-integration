<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_view_openmes" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.openmes</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="openmes_workstation_code" groups="mrp.group_mrp_manager"/>
            </xpath>
        </field>
    </record>

    <record id="mrp_workcenter_tree_view_openmes" model="ir.ui.view">
        <field name="name">mrp.workcenter.list.openmes</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="openmes_workstation_code" optional="hide" groups="mrp.group_mrp_manager"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_openmes_sync_log_list" model="ir.ui.view">
        <field name="name">openmes.sync.log.list</field>
        <field name="model">openmes.sync.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" decoration-danger="state == 'failed'" decoration-warning="state == 'partial'">
                <field name="create_date" string="Date"/>
                <field name="operation"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-warning="state == 'partial'" decoration-danger="state == 'failed'"/>
                <field name="sent_count"/>
                <field name="imported_count"/>
                <field name="updated_count"/>
                <field name="skipped_count"/>
                <field name="error_count"/>
            </list>
        </field>
    </record>

    <record id="view_openmes_sync_log_form" model="ir.ui.view">
        <field name="name">openmes.sync.log.form</field>
        <field name="model">openmes.sync.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="state"/>
                            <field name="create_date" string="Date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="sent_count"/>
                            <field name="imported_count"/>
                            <field name="updated_count"/>
                            <field name="skipped_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <field name="message" invisible="not message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_openmes_sync_log" model="ir.actions.act_window">
        <field name="name">OpenMES Sync Log</field>
        <field name="res_model">openmes.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

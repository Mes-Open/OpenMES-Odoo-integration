<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_openmes" model="ir.ui.view">
        <field name="name">product.template.form.openmes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="OpenMES" name="openmes">
                    <group>
                        <group>
                            <field name="openmes_manufacture"/>
                            <field name="openmes_line_id" invisible="not openmes_manufacture" placeholder="Default line from Settings" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2" invisible="not openmes_manufacture">
                                The Internal Reference is used as the OpenMES product type code, and the
                                components of this product's bill of materials are synchronised as materials.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_openmes" model="ir.ui.view">
        <field name="name">product.template.search.openmes</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter name="filter_openmes" string="Manufactured in OpenMES" domain="[('openmes_manufacture', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
